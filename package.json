{
  "name": "telegram-bots-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "description": "Hub multi-bots Telegram serverless sur Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/check-cloudflare-config.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply telegram-bots-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply telegram-bots-hub --remote",
    "webhooks:register": "tsx scripts/register-webhooks.ts"
  },
  "dependencies": {
    "hono": "4.13.13",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "wrangler": "4.147.0"
  }
}
